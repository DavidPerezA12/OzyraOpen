# ============================================================================
# ENVIRONMENT VARIABLES - SAFE TEMPLATE
# ============================================================================
#
# IMPORTANT:
# - Copy this file to .env.local for development
# - NEVER commit .env files with real values
# - VITE_ variables are public and visible in the frontend bundle
#
# ============================================================================

# ============================================================================
# FRONTEND VARIABLES (visible in the browser)
# ============================================================================
# Every VITE_ value is exposed to the client. Leave keys empty if you do not
# want to publish them.

# OpenRouter
VITE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VITE_OPENROUTER_SITE_URL=http://localhost:5173
VITE_OPENROUTER_APP_TITLE=Ozyra Open

# Optional direct web search providers
# Note: these keys are also visible in the browser.
VITE_TAVILY_API_KEY=
VITE_BRAVE_SEARCH_API_KEY=

# Site URL
VITE_SITE_URL=http://localhost:5173

# Development settings
VITE_DEBUG=false
